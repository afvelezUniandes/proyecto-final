{
  "info": {
    "name": "TravelHub Microservices",
    "description": "Colección de pruebas para los microservicios de TravelHub en AWS ECS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://proyecto-final-alb-1238672503.us-east-1.elb.amazonaws.com",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Verifica el estado de salud del sistema completo"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Usuario creado exitosamente\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\",\n  \"telefono\": \"+123456789\",\n  \"pais\": \"Colombia\",\n  \"idioma_preferido\": \"es\",\n  \"rol\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/sign-up",
              "host": ["{{base_url}}"],
              "path": ["auth", "sign-up"]
            },
            "description": "Registra un nuevo usuario en el sistema"
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"auth_token\", jsonData.token);",
                  "        pm.test(\"Token guardado\", function () {",
                  "            pm.expect(jsonData.token).to.be.a('string');",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/sign-in",
              "host": ["{{base_url}}"],
              "path": ["auth", "sign-in"]
            },
            "description": "Inicia sesión y obtiene un token JWT"
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/sign-out",
              "host": ["{{base_url}}"],
              "path": ["auth", "sign-out"]
            },
            "description": "Cierra la sesión del usuario autenticado"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Get Hotels",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response tiene estructura correcta\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('hotels');",
                  "    pm.expect(jsonData).to.have.property('page');",
                  "    pm.expect(jsonData).to.have.property('per_page');",
                  "    pm.expect(jsonData).to.have.property('total');",
                  "});",
                  "",
                  "pm.test(\"Response time es menor a 900ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(900);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/catalog/hotels?page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["catalog", "hotels"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "ciudad",
                  "value": "Bogota",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Obtiene la lista de hoteles con paginación"
          }
        },
        {
          "name": "Get Rooms",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time es menor a 900ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(900);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/catalog/rooms?page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["catalog", "rooms"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "hotel_id",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "Obtiene la lista de habitaciones con paginación"
          }
        }
      ]
    },
    {
      "name": "Load Test - Hotels",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/catalog/hotels",
          "host": ["{{base_url}}"],
          "path": ["catalog", "hotels"]
        },
        "description": "Endpoint para pruebas de carga: GET /catalog/hotels"
      }
    }
  ]
}
