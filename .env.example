# TravelHub - Variables de entorno
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env

# Base de datos RDS
RDS_HOST=travelhub-db.cipyouuaqkqn.us-east-1.rds.amazonaws.com
RDS_USER=postgres
RDS_PASS=your_db_password_here

# JWT
JWT_SECRET=your_jwt_secret_here_must_be_long_and_complex

# S3
S3_BUCKET=travelhub-images-proyecto
S3_REGION=us-east-1
